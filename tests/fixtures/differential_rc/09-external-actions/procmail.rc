OUT=$1
COMSAT=no
MAILDIR=.
TOKEN=yes
TARGET=missing

:0 fhw
| sed 's/^Subject: External actions$/Subject: Header filtered/'

:0 fbW
| sed 's/^body old$/body filtered/'

:0 W
* ? test "$TOKEN" = yes
{
  TARGET=result
}

:0
$OUT/$TARGET
