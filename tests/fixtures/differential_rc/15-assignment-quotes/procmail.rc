OUT=$1
COMSAT=no
EXPANDED=route
SINGLE='$EXPANDED-`printf wrong`-\-#'
MIXED=pre'-'$EXPANDED"-"'post'
HASH=value#suffix # ignored
SPACE=left\ right

:0 r
* SINGLE ?? EXPANDED.*printf wrong.*\\-#
* MIXED ?? pre-route-post
* HASH ?? value#suffix
* SPACE ?? left right
$OUT/$MIXED
