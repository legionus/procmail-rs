OUT=$1
COMSAT=no

:0 c
* ^Subject: prefix \/[^ ]+
$OUT/01-captured

:0 c
* MATCH ?? ^alpha-beta-tail$
$OUT/02-first-span

:0 c
* ^X-Code: \/[0-9][0-9]
$OUT/03-captured

:0 c
* MATCH ?? ^42$
$OUT/04-second-span

:0
$OUT/99-final
