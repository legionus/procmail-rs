selector_zero="\x00"
selector_one="\x01"
selector_two="\x02"
selector_three="\x03"
selector_four="\x04"
selector_five="\x05"
selector_six="\x06"
selector_seven="\x07"

separator="\x00"
discard="\x01:0\x0a/dev/null\x0a\x00Subject: fuzz\x0a\x0abody"
copy=":0 c\x0a/dev/null\x0a"
block=":0\x0a{\x0a:0\x0a/dev/null\x0a}\x0a"
nest=":0\x0a{\x0a:0\x0a{\x0a:0\x0a/dev/null\x0a}\x0a}\x0a"
include="INCLUDERC=fuzz.rc\x0a"
switch="SWITCHRC=fuzz.rc\x0a"
pipe=":0 w\x0a| fuzz-command\x0a"
pipe_filter=":0 f\x0a| fuzz-filter\x0a"
program_cond=":0 x\x0a* ? fuzz-condition\x0a/dev/null\x0a"
regex_cond=":0\x0a* H ^Subject: fuzz\x0a/dev/null\x0a"
negate_cond=":0\x0a* H !^Subject:\x0a/dev/null\x0a"
size_cond=":0\x0a* > 9\x0a/dev/null\x0a"
capture="VALUE=`fuzz-capture`\x0a"
capture_action=":0\x0aVALUE=| fuzz-capture\x0a"
lock=":0 : fuzz.lock\x0a/dev/null\x0a"
global_lock="LOCKFILE=fuzz.lock\x0a"
lock_zero="LOCKFILE=\x0a"

header_in="Subject: fuzz\x0a\x0a"
header_folded="Subject: first\x0a second\x0a\x0a"
header_crlf="Subject: fuzz\x0d\x0a\x0d\x0a"
body_only="fuzz body"
empty_in="\x0a\x0a"
body_binary="fuzz body\x00\xff"

lim_lock="LOCKTIMEOUT=86400"
lim_timeout="TIMEOUT=960"
trap="TRAP=fuzz-trap"
umask="UMASK=077"
linebuf="LINEBUF=2048"
assign_shell="VAR=${value:-word}\x0a"
assign_cmd="VALUE=`fuzz-capture`\x0a"
limit_assign="LIMIT_MSG_SIZE=64\x0a"
limit_cond="LIMIT_RC_CONDITIONS=2\x0a"
include_chain="INCLUDERC=fuzz.rc\x0aINCLUDERC=fuzz.rc\x0a"
copy_chain=":0 c\x0a/dev/null\x0a:0 c\x0a/dev/null\x0a"
control_after=":0 A\x0a/dev/null\x0a"
control_else=":0 E\x0a/dev/null\x0a"
control_err=":0 e\x0a/dev/null\x0a"
