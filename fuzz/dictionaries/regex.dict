separator="\x00"
start="^"
end="$"
absolute="^^"
match="\\/"
word_start="\\<"
word_end="\\>"
to="^TO"
to_address="^TO_"
from_daemon="^FROM_DAEMON"
from_mailer="^FROM_MAILER"
capture="(value)"
named="(?P<name>value)"
alternation="(left|right)"
class="[^a-zA-Z0-9_]"
repeat="{1,64}"
