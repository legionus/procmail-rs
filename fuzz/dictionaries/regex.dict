separator="\x00"

# anchors and procmail-specific macros
start="^"
end="$"
start_line="^$"
absolute_begin="^^"
absolute_end="\x00^^"
mid_abs="a^^b"
match_marker="\\/"
match_multi="\\//\\/"
word_begin="\\<"
word_end="\\>"
word_pair="\\<word\\>"
to="^TO"
to_address="^TO_"
from_daemon="^FROM_DAEMON"
from_mailer="^FROM_MAILER"
anchored_daemon="^FROM_DAEMON.*\\/"
negate_daemon="!^FROM_DAEMON"
negate_mailer="!^FROM_MAILER"
negate_to="!^TO"
negate_to_addr="!^TO_"
negate_word="!\\<\\>"
macro_nest="(a)\\<\\>"

# byte-regex extensions from the `regex` crate
capture="(value)"
capture_nested="((a)(b))"
capture_named="(?P<name>value)"
capture_named_ref="(?P<name>v)(?P=name)"
lazy_star="lazy*?"
lazy_plus="lazy+?"
possessive_star="possess*+"
case_insens="(?i)abc"
case_off="(?-i)abc"
dot_all="(?s)\\n"
dot_off="(?-s)\\n"
multi_line="^m1|m\\$"
unicode_off="(?-u)a"
empty_class="(?=a)"
hex_esc="\\x41"
byte_range="\\x20-\\x7e"
byte_class="\\pN\\pS"
class_negate="[^a-z]"
class_all="[^\\x00-\\xff]"
negate_hex="[^\\x00]"
class_range="a-c"
range_neg="a\\-c"
escape_bracket="\\["
escape_paren="\\("
escape_star="\\*"
escape_dollar="\\$"
escape_caret="\\^"
escape_backslash="\\\\"
quote_off="\\Q\\E"
word_boundary="\\b"
word_nonboundary="\\B"
word_both="\\b\\B"
repeat="{1,2}"
repeat_low="{2,}"
repeat_empty="{a}"
repeat_zero="{0}"
repeat_one="{1}"
many_star="a*a*a*a*a*"
many_plus="a+a+a+a+a+"

# alternation and grouping
alt="(a|b)"
alt_nested="((a)|(b))"
empty_group="()"
empty_alt="a|(b)"
one_branch="(a)"
two_branch="(a|b)"
three_branch="(a|b|c)"
empty_alt2="(?P<x>)(?<y>)"
