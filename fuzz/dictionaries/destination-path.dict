maildir="maildir:"
mbox="mbox:"
trailing="/fuzz/"
double_trailing="//"
discard="/dev/null"
absolute="/var/mail/fuzz"
deep="/var/mail/fuzz/inbox/"
relative="relative/path"
parent="../"
parent_trail="../fuzz/"
current="./"
double_sep="//"
triple_sep="///"
dot_component="."
dotdot_component=".."
slash="/"
nul="\x00"
nul_mid="/a\x00b"
dot_path=".hidden"
dotdir=".fuzz"
dotdot=".."
dotdot_only="../"
doubledot="a..b"
space="/a b"
quote="/'a' b"
tilde="~user/fuzz"
colon="/:fuzz/"
glob="/var/mail/*"

variable="$FUZZ_VALUE"
braced="${FUZZ_VALUE}"
default="${FUZZ_VALUE:-fallback}"
default_empty="${FUZZ_VALUE:-}"
plus="${FUZZ_VALUE:+word}"
plus_empty="${FUZZ_VALUE:+=}"
assign_form="${FUZZ_VALUE:=set}"
required="${FUZZ_VALUE:?word}"
required_empty="${FUZZ_VALUE:?}"
length="#FUZZ_VALUE"
prefix="${FUZZ_VALUE#pattern}"
suffix="${FUZZ_VALUE%pattern}"
uppercase="${FUZZ_VALUE^^[a-z]}"
lowercase="${FUZZ_VALUE,,[A-Z]}"
double_quote="\"${FUZZ_VALUE}\""
single_quote="'${FUZZ_VALUE}'"
nested="${FUZZ_VALUE:-${OTHER:-fallback}}"
concat="$A$B"
two_words="${FUZZ_VALUE} other"

command="`fuzz-command`"
command_out="`fuzz-capture` /dest"
command_nested="`echo `inner`"
command_empty="``"
command_var="`cmd ${FUZZ_VALUE}`"
command_dash="`ls -- ${FUZZ_VALUE}`"

base_dot="."
base_relative="base"
base_abs="/base/fuzz"
base_dot="/."
base_double="/fuzz//"
base_trail="/fuzz/"
base_maildir="/var/mail/"
base_parent="../"
base_nul="/a\x00b"
