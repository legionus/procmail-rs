separator="\x00"
variable="$FUZZ_VALUE"
braced="${FUZZ_VALUE}"
default="${FUZZ_VALUE:-fallback}"
command="`fuzz-command`"
maildir="maildir:"
mbox="mbox:"
discard="/dev/null"
parent="../"
current="./"
repeated="//"
absolute="/var/mail/fuzz"
relative="relative/path"
