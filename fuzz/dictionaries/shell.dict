plain="$NAME"
braced="${NAME}"
default="${NAME:-word}"
nested="${NAME:-${OTHER:-word}}"
depth_16="${A:-${B:-${C:-${D:-${E:-${F:-${G:-${H:-${I:-${J:-deep"}}}}}}}}}}"
alternate="${NAME:+word}"
empty_word="${NAME:-}"
empty_plus="${NAME:+}"
assign="${NAME:=word}"
assign_empty="${NAME:=}"
required="${NAME:?word}"
required_empty="${NAME:?}"
length="${#NAME}"
empty_undef="${#UNDEF}"
prefix="${NAME#pattern}"
long_prefix="${NAME##pattern}"
suffix="${NAME%pattern}"
long_suffix="${NAME%%pattern}"
empty_pattern="${NAME#}"
empty_double="${NAME##}"
upper="${NAME^^[a-z]}"
upper_all="${NAME^^}"
lower="${NAME,,[A-Z]}"
lower_all="${NAME,,}"
upper_class="${NAME^^[!a-z]}"
lower_class="${NAME,,[^A-Z]}"
single="'${NAME}`command`\\'"
double="\"${NAME:-word}\\\"\""
single_newline="'a\x0ab'"
double_newline="\"a\x0ab\""
double_dollar="$$"
backtick_dollar="`echo ${NAME}`"
escaped_dollar="\\$NAME"
command="`printf fuzz`"
command_nested="`echo `echo inner`"
command_empty="``"
class="[!a-z]"
negate_caret="[^a-z]"
class_range="[a-z0-9]"
class_range_neg="[^a-fA-F]"
class_empty="[]"
class_bad_range="[z-a]"
question="?"
stars="****"
star_question="*?*"
class_in_pattern="[a-z]*"
quoted_pattern="a'b*'"
concat="a`cmd`${NAME}"
unquoted_2words="one two"
hash_comment="value # not comment inside word"
bare_hash="# only comment"
