separator="\x00"
remove="remove Subject"
set="set Subject changed"
set_empty="set Subject"
set_quoted="set Subject \"word ${NAME} `"
add="add X-Test value"
prepend="prepend Delivered-To user@example.test"
rename="rename List-Id to X-List-Id"
rename_no_kw="rename List-Id X-List-Id"
extract_raw="extract raw Subject into VALUE"
extract_unfolded="extract unfolded Subject into VALUE"
extract_decoded="extract decoded Subject into VALUE"
extract_bad_mode="extract bogus Subject into VALUE"
extract_no_into="extract raw Subject VALUE"
bad_op="delete Subject"
op_name_only="set"
op_ws="\x09"
header_name="X-Test-Header"
extract_runtime="extract raw Subject into LASTFOLDER"
extract_128="extract raw Subject into AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
extract_129="extract raw Subject into AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
folded_value="set Subject value\\"
lf_message="\x00Subject: old\x0a\x0abody"
crlf_message="\x00Subject: old\x0d\x0a\x0d\x0abody"
folded="\x00Subject: first\x0a continued\x0a\x0abody"
folded_crlf="\x00Subject: first\x0d continued\x0d\x0abody"
binary="\x00X-Binary: \xff\x00value\x0a\x0abody\x00\xff"
no_separator="\x01"
empty_message="\x00"
one_hdr_no_body="\x00Subject: only"
many_headers="\x00A: 1\x0aB: 1\x0aC: 1\x0a\x0abody"
empty_hdr_value="\x00Subject:\x0a\x0abody"
long_value="\x00Subject: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\x0a\x0abody"
