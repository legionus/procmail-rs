# recipe framing and control flow
recipe=":0"
copy=":0 c"
case=":0 D"
after_chain=":0 A"
after_success=":0 a"
else_=":0 E"
after_error=":0 e"
filter_body=":0 b"
filter_headers=":0 h"
filter=":0 f"
wait=":0 w"
wait_quiet=":0 W"
preserve_ending=":0 r"
lockfile=":0 : fuzz.local"
no_flag_lock=":0 :"
open_block="{"
close_block="}"
forward="! fuzzer@example.test"
empty_line="\x0a"
comment="# a comment line"

# conditions by area and negation
c_header="* H ^Subject: fuzz"
c_body="* B fuzz"
c_message="* fuzz"
c_negate="* H !^Subject:"
c_size="* > 1"
c_program="* ? fuzz-condition"
c_var="* NAME ?? ^value"

# destination backends and paths
maildir="maildir:"
mbox="mbox:"
maildir_path="maildir:/var/mail/fuzz/"
mbox_path="mbox:/var/mail/fuzz"
trailing_slug="/var/mail/fuzz/"
discard="/dev/null"
unmarked="fuzzbox"
parent="../"
current="./"
double_sep="//"
nul_escape="\x00"

# pipe, capture, and headers actions
pipe="| fuzz-command"
pipe_backslash="| fuzz-command \\"
capture="VALUE=| fuzz-capture"
headers_block="headers {"
headers_close="}"
op_remove="remove Subject"
op_set="set Subject changed"
op_add="add X-Test value"
op_prepend="prepend Delivered-To user@example.test"
op_rename="rename List-Id to X-List-Id"
op_capture="extract raw Subject into VALUE"
op_capture_folded="extract unfolded Subject into VALUE"
op_capture_decoded="extract decoded Subject into VALUE"

# shell-like assignment values
assign_plain="VAR=value"
assign_brace="VAR=${value}"
assign_word="VAR=${value:-fallback}"
assign_plus="VAR=${value:+word}"
assign_set="VAR=${value:=word}"
assign_req="VAR=${value:?word}"
assign_len="VAR=${#value}"
assign_prefix="VAR=${value#pattern}"
assign_suffix="VAR=${value%pattern}"
assign_upper="VAR=${value^^[a-z]}"
assign_lower="VAR=${value,,[A-Z]}"
assign_quote="'word 'other'"
assign_double="\"word ${value} \\x\""
assign_command="VALUE=`fuzz-command`"
assign_comment="# trailing comment"
second_word="VAR=one two"

# limits within and beyond hard ceilings
lim_msg_size="LIMIT_MSG_SIZE=64"
lim_headers="LIMIT_MSG_HEADERS=256"
lim_body="LIMIT_MSG_BODY=1"
lim_header_line="LIMIT_HEADER_LINE=2048"
lim_header_field="LIMIT_HEADER_FIELD=4096"
lim_max="256"
lim_over="65536"
lim_overflow="99999999999999999999"
lim_suffix="64K"
lim_suffix_m="64M"
lim_suffix_g="4G"
lim_bad_suffix="64X"
lim_assignments="LIMIT_MAX_ASSIGNMENTS=1"
lim_statements="LIMIT_RC_STATEMENTS=1024"
lim_recipes="LIMIT_RC_RECIPES=4"
lim_conditions="LIMIT_RC_CONDITIONS=8"
lim_regexes="LIMIT_RC_REGEXES=16"
lim_recipe_cond="LIMIT_RECIPE_CONDITIONS=2"
lim_recipe_nest="LIMIT_RECIPE_NESTING=1"
lim_unsupported="LIMIT_RC_SIZE=1"

# policy / runtime assignments
include="INCLUDERC=fuzz.rc"
switch="SWITCHRC=fuzz.rc"
lockmethod_flock="LOCKMETHOD=flock"
lockmethod_dot="LOCKMETHOD=dotlock"
lockmethod_bad="LOCKMETHOD=other"
lockfile_set="LOCKFILE=fuzz.lock"
lockfile_clear="LOCKFILE="
locktimeout="LOCKTIMEOUT=86400"
locktimeout_zero="LOCKTIMEOUT=0"
locktimeout_over="LOCKTIMEOUT=86401"
timeout="TIMEOUT=960"
timeout_over="TIMEOUT=86401"
umask="UMASK=077"
umask_open="UMASK=0000"
umask_over="UMASK=0778"
trap="TRAP=fuzz-trap"
trap_empty="TRAP="
logdetail="LOGDETAIL=values"
verbose="VERBOSE"
logfile="LOGFILE=fuzz.log"
host="HOST=fuzz-host"
linebuf="LINEBUF=2048"
linebuf_low="LINEBUF=128"
linebuf_high="LINEBUF=4096"
linebuf_under="LINEBUF=64"
linebuf_nonlit="LINEBUF=${value}"
name_128="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=value"
name_129="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=value"
unsupported="PROCMAIL_OVERFLOW=x"
empty_name="=value"
name_digit="1NAME=value"

# unsupported / malformed rc constructs
recipe_flags_bad=":0 x"
recipe_flags_two_ctrl=":0 Aa"
pipe_missing="| "
pipe_flags_deliver=":0 f"
headers_flags=":0 c headers {"
capture_bad_name="1NAME=| fuzz"
block_lock=":0 : lock {"
dest_whitespace="one two"
recipe_no_action=":0\x0a"
recipe_action_empty=":0 c\x0a"
