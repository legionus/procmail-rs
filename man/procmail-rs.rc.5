\f[CR]${NAME\-word}\f[R]
T}@T{
\f[CR]word\f[R]
T}@T{
empty value
T}@T{
value
T}
T{
\f[CR]${NAME:\-word}\f[R]
T}@T{
\f[CR]word\f[R]
T}@T{
\f[CR]word\f[R]
T}@T{
value
T}
T{
\f[CR]${NAME+word}\f[R]
T}@T{
empty
T}@T{
\f[CR]word\f[R]
T}@T{
\f[CR]word\f[R]
T}
T{
\f[CR]${NAME:+word}\f[R]
T}@T{
empty
T}@T{
empty
T}@T{
\f[CR]word\f[R]
T}
